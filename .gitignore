# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environment (recreate from requirements.txt)
venv/
.venv/

# Cloned reference repos & datasets (huge — not part of this project)
references/

# Runtime / debug artifacts
debug/
_dbgsrv.txt

# Enrolled biometric templates & keys (never commit user data or secrets)
database/
*.pkl
*.key
fp_db.key

# OS
.DS_Store
Thumbs.db

# scratch screenshots dropped in the repo root
/image*.png

# Personal face/ID fixtures for ID-detection tests (biometric data — never commit)
/Image.jpeg
/me.jpeg

# SourceAFIS jars (re-fetch via Maven; see libs/README.md)
libs/*.jar

# Face templates (runtime user data)
face_db/

# jars anywhere (re-fetchable)
*.jar

# Local passphrase backup (NEVER commit)
.face_db_key_BACKUP.txt
.face_db_key*

# Deployment secrets
.env

# Runtime issuer signing keys + issued-credential registry (private key material —
# BIO_CREDENTIALS_DIR / issuer_keys default here; never commit)
secrets/

# Service-subsystem registries (per-tenant policies/guests/devices/guardians/consent —
# operational data, never commit)
policies.json
guests.json
devices.json
guardians.json
consent.json
invites.json

# API keys + operator accounts (hashed, but never commit) + per-tenant stores
apikeys.json
admins.json
tenants.json
face_db/

# Audit trail (contains user ids / PII), usage counters, backups, test artifacts
audit_logs/
usage.json
backups/
tests/_test_*

# Palm: CCNet export scratch + large model weights (export via palm/training/export_ccnet_onnx.py)
_ccnet_work/
palm/models/*.onnx

# Real palm images for local eval (biometric data — never commit)
WhatsApp Image*.jpeg
WhatsApp Image*.jpg
_eval_palms/
captures/
IMG_*.jpg
IMG_*.JPG

# Android Kotlin daemon session files
android/.kotlin/

# Exported user lists (PII) + benchmark snapshots (contain biometric embeddings)
people*.csv
_bench_snaps/
examples/**/*.db

# PAD / anti-spoof eval data (live + spoof face images — biometric data) + its output
pad_data/
_pad_threshold.json
# Android build logs (generated by scripts/build_flavors.py etc.)
android/build_*.log

# .gear local tool state (timeline db)
.gear/

# Temporary analytics pulls from the live Space (biometric embeddings — never commit)
_analytics/
collect/

# Field data: real capture frames + decisions pulled from production (biometric
# data — never commit). Server-side folder AND the local pull output.
fielddata/
_fielddata/

# Disaster-recovery copy of the live deployment's state dataset: templates AND
# their encryption key material. Never commit.
_backup_prod/

# Local pilot state (templates, captures, logs) — never commit
_prod_state/
