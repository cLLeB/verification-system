# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# Generate secrets with:  openssl rand -base64 24

# --- required ---------------------------------------------------------------

# Your domain (DNS A/AAAA record must point at this server). Caddy gets HTTPS for it.
# No domain? A free duckdns.org subdomain works and still earns a real
# certificate - browsers refuse camera access without valid TLS.
DOMAIN=face.example.com

# Operator login for /admin (or create accounts with manage_admins.py).
FACE_ADMIN_PASSWORD=change-me-now

# Session cookie signing.
FACE_SECRET_KEY=replace-with-a-long-random-string

# Derives the key that encrypts every stored template.
# KEEP A COPY SOMEWHERE ELSE. Lose it and every enrolled face and palm becomes
# permanently unreadable - an encrypted backup without it is just noise.
# (FACE_DB_KEY and FP_DB_KEY are still accepted, for stores created earlier.)
BIO_DB_KEY=replace-with-another-long-random-secret

# --- private-link access ----------------------------------------------------
# Set this and the whole site answers only to  https://<domain>/?k=<token>
# - one tap for the people you invite, a bare 404 for everyone else. Leave it
# EMPTY and the site is fully public, enrolment included.
FACE_LINK_TOKEN=

# --- pilot data collection --------------------------------------------------
# Enables the export endpoints pull_production.py reads. Without it they 404 and
# captures accumulate on the server with no way to retrieve them.
FACE_ANALYTICS_TOKEN=

# Durable state where the disk is ephemeral: everything under /data syncs to a
# PRIVATE Hugging Face Dataset every 60s and restores on boot. Also how
# enrolments follow you between hosts - point the new box at the same dataset
# and they are simply there.
FACE_PERSIST_DATASET=
HF_TOKEN=

# --- optional ---------------------------------------------------------------
# The image already sets these; override only deliberately:
#   FACE_OPEN_ENROLL=1     no password to enrol (pilot). 0 restores the login.
#   FACE_FIELD_DATA=1      record every capture + decision for tuning. 0 stops it.
#   FACE_RATE_LIMIT=600    per IP per minute - testers behind one NAT share an IP.
#
# FACE_ACTIVE_LIVENESS=0   drops the face head-turn check, and the 3D landmark
#                          model with it (~140 MB). Needed on a 1 GB host; leave
#                          it on wherever you have the memory.
# PALM_ADAPTIVE=0          freeze palm templates, so a false accept cannot become
#                          permanent while you are chasing cross-identity mixups.
# FACE_SIGNING_SECRET=     HMAC-sign first-party verify results
# FACE_CORS_ORIGINS=https://yourapp.com,https://admin.yourapp.com
# FACE_RATE_WINDOW=60
